# Checked-in ARES production contract (non-secret).
# Copy to env/.env.ares for local overrides if needed.
#
# Release / CI / fresh clones load this file when env/.env.ares is absent
# (gitignored). Values must match apps/mobile/lib/aresReleaseEnv.cjs and
# eas.json profile production-ares.
#
# Build: WHITELABEL_PROFILE=ares EXPO_NO_DOTENV=1 …
# Verify: pnpm --filter mobile config:verify:ares

EXPO_PUBLIC_API_URL=https://api-production-8a0e.up.railway.app
EXPO_PUBLIC_STUDIO_SLUG=ares-fitness

APP_DISPLAY_NAME=Ares Training Club
# iOS CFBundleDisplayName / Android android:label (home screen / launcher).
APP_LAUNCHER_NAME=ARES
APP_SCHEME=aresfitness
EXPO_SLUG=gymos

IOS_BUNDLE_IDENTIFIER=com.fraterunion.aresfitness
ANDROID_PACKAGE=com.fraterunion.aresfitness

APP_ICON_PATH=./assets/branding/ares/icon.png
APP_SPLASH_PATH=./assets/branding/ares/splash-screen.png
APP_SPLASH_BG_COLOR=#000000
APP_ADAPTIVE_ICON_PATH=./assets/branding/ares/adaptive-icon.png
APP_ADAPTIVE_ICON_BG_COLOR=#000000
APP_VERSION=1.1
IOS_BUILD_NUMBER=8
