# Quick start: copy to `apps/mobile/.env` (gitignored).
# For white-label native settings + profile-based env, see `env/.env.local.example` and `docs/WHITE_LABEL_BUILDS.md`.
#
# Precedence: explicit env > env/.env.<WHITELABEL_PROFILE> > this file (fill-only).
# This file never overrides a client profile or shell/EAS values. Safe for local localhost.

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_STUDIO_SLUG=your-studio-slug

# Optional: use tenant env files instead (recommended for real client builds).
# WHITELABEL_PROFILE=local
